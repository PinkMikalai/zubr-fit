# MODÈLE UNIQUEMENT — ne contient aucun vrai secret, safe à committer.
#
# Sur le serveur O2switch (en SSH), copie ce contenu dans un fichier nommé
# ".env.prod.local" à la racine de backend/ et remplis les vraies valeurs.
# Ce fichier ne doit JAMAIS être ajouté à Git (il est déjà exclu par .gitignore
# via la règle ".env.*") : il n'existe que sur le serveur, jamais dans une branche.

###> symfony/framework-bundle ###
APP_ENV=prod
# Génère une valeur aléatoire en SSH : php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=https://api.zubr-fit.com
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Identifiants de la base MySQL créée dans cPanel ("Bases de données MySQL").
# Sur O2switch, l'hôte est en général "localhost".
DATABASE_URL="mysql://UTILISATEUR:MOT_DE_PASSE@localhost:3306/NOM_BASE?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Passphrase différente de celle utilisée en dev/Docker
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
# N'autorise que le vrai domaine du frontend en production (pas localhost)
CORS_ALLOW_ORIGIN='^https://zubr-fit\.com$'
###< nelmio/cors-bundle ###
